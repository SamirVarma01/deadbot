# Required
DISCORD_TOKEN=

# Optional but recommended: higher rate-limit share on deadlock-api.com
DEADLOCK_API_KEY=
# Optional: resolves Steam custom URLs via the official API (falls back to public profile XML)
STEAM_API_KEY=

# Local defaults (docker-compose overrides these for the bot container)
DATABASE_URL=postgresql+asyncpg://deadbot:deadbot@localhost:5432/deadbot
REDIS_URL=redis://localhost:6379/0

# Development: register slash commands to one server instantly instead of globally
DEV_GUILD_ID=

# Tuning (defaults shown)
# SYNC_INTERVAL_MINUTES=30
# TEAMMATES_MIN_GAMES=3
# SYNERGY_PRIOR_STRENGTH=20
# ENABLE_PRESENCE_INTENT=false
# LOG_LEVEL=INFO
